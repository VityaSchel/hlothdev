{
	"name": "hloth.dev",
	"version": "1.0.0",
	"description": "The personal website of Viktor Shchelochkov aka hloth.",
	"homepage": "https://git.hloth.dev/hloth/hloth.dev",
	"bugs": {
		"url": "https://git.hloth.dev/hloth/hloth.dev/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://git.hloth.dev/hloth/hloth.dev.git"
	},
	"funding": "https://hloth.dev/donate",
	"license": "MIT",
	"author": "Viktor Shchelochkov <hi@hloth.dev> (https://hloth.dev)",
	"type": "module",
	"scripts": {
		"build": "bun vite build",
		"check": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo",
		"check:watch": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --watch",
		"dev": "bun vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "husky",
		"preview": "bun vite preview"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --cache --fix",
			"prettier --write"
		]
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/sofia-sans-condensed": "^5.3.0",
		"@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
		"figma-squircle": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"network-information-types": "^0.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-classnames": "^0.10.4",
		"prettier-plugin-merge": "^0.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass-embedded": "^1.105.0",
		"sharp": "^0.35.4",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"sharp": "$sharp"
	}
}
